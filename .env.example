# Application
ENVIRONMENT=development
DEBUG=true
FRONTEND_BASE_URL=http://localhost:3000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=adaptive_assessment
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=uploads
S3_ENDPOINT_URL=http://minio:9000

# Email / MailHog
EMAILS_ENABLED=true
EMAIL_FROM_NAME=Adaptive Assessment Platform
EMAIL_FROM_ADDRESS=noreply@localhost
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=false
MAILHOG_UI_URL=http://localhost:8025

# OAuth
AUTH_SESSION_SECRET_KEY=change-me-session-secret-with-at-least-32-characters
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

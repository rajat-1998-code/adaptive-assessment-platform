# Application
ENVIRONMENT=development
DEBUG=true
FRONTEND_BASE_URL=http://localhost:3000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=adaptive_assessment
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Email / MailHog
EMAILS_ENABLED=true
EMAIL_FROM_NAME=Adaptive Assessment Platform
EMAIL_FROM_ADDRESS=noreply@localhost
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=false
MAILHOG_UI_URL=http://localhost:8025
